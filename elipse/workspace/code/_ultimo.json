{"lang": "html", "code": "<div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-16\">\n  <img src=\"data:image/svg+xml;base64,\" alt=\"Postre en presentación\" class=\"rounded-3xl shadow-lg w-full\" />\n  <img src=\"data:image/svg+xml;base64,\" alt=\"Bebida en copa\" class=\"rounded-3xl shadow-lg w-full\" />\n</div>\n<!-- Horarios -->\n<section class=\"py-24 bg-background text-center\">\n  <div class=\"max-w-7xl mx-auto px-4\">\n    <h2 class=\"text-3xl font-serif text-text mb-4\">Horarios de Apertura</h2>\n    <p class=\"text-gray-600 mb-8\">Visítanos según tus horarios preferidos</p>\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto\">\n      <div class=\"bg-white rounded-3xl p-8 shadow-lg\">\n        <h3 class=\"text-2xl font-bold text-primary mb-4\">Lunes a Viernes</h3>\n        <p class=\"text-gray-800\">07:00 AM – 08:00 PM</p>\n      </div>\n      <div class=\"bg-white rounded-3xl p-8 shadow-lg\">\n        <h3 class=\"text-2xl font-bold text-primary mb-4\">Sábados y Domingos</h3>\n        <p class=\"text-gray-800\">08:00 AM – 10:00 PM</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Formulario de Reserva -->\n<section id=\"reserva\" class=\"py-24 bg-primary text-white\">\n  <div class=\"max-w-4xl mx-auto px-4 text-center mb-16\">\n    <h2 class=\"text-3xl font-serif mb-4\">Reserva tu Mesa</h2>\n    <p class=\"text-primary-100\">Completa el siguiente formulario para reservar una mesa</p>\n  </div>\n  <div class=\"max-w-4xl mx-auto bg-white rounded-3xl p-8 shadow-2xl\">\n    <form class=\"space-y-6\">\n      <div>\n        <label for=\"nombre\" class=\"block mb-2 font-semibold\">Nombre completo</label>\n        <input type=\"text\" id=\"nombre\" class=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\" placeholder=\"Ej. Juan Pérez\" required />\n      </div>\n      <div>\n        <label for=\"email\" class=\"block mb-2 font-semibold\">Correo electrónico</label>\n        <input type=\"email\" id=\"email\" class=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\" placeholder=\"ejemplo@dominio.com\" required />\n      </div>\n      <div>\n        <label for=\"fecha\" class=\"block mb-2 font-semibold\">Fecha de reserva</label>\n        <input type=\"date\" id=\"fecha\" class=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\" required />\n      </div>\n      <div>\n        <label for=\"hora\" class=\"block mb-2 font-semibold\">Hora de reserva</label>\n        <select id=\"hora\" class=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\" required>\n          <option value=\"\" disabled selected>Selecciona una hora</option>\n          <option value=\"10:00\">10:00</option>\n          <option value=\"11:00\">11:00</option>\n          <option value=\"12:00\">12:00</option>\n          <option value=\"13:00\">13:00</option>\n          <option value=\"14:00\">14:00</option>\n          <option value=\"15:00\">15:00</option>\n          <option value=\"16:00\">16:00</option>\n          <option value=\"17:00\">17:00</option>\n          <option value=\"18:00\">18:00</option>\n<option value=\"19:00\">19:00</option>\n<option value=\"20:00\">20:00</option>\n<option value=\"21:00\">21:00</option>\n<option value=\"22:00\">22:00</option>\n</select>\n</div>\n<div>\n  <label for=\"personas\" class=\"block mb-2 font-semibold\">Número de personas</label>\n  <select id=\"personas\" class=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\" required>\n    <option value=\"\" disabled selected>Selecciona el número de personas</option>\n    <option value=\"1\">1 persona</option>\n    <option value=\"2\">2 personas</option>\n    <option value=\"3\">3 personas</option>\n    <option value=\"4\">4 personas</option>\n    <option value=\"5\">5 personas</option>\n    <option value=\"6\">6 personas</option>\n    <option value=\"7\">7 personas</option>\n    <option value=\"8\">8 personas</option>\n    <option value=\"9\">9 personas</option>\n    <option value=\"10\">10 personas</option>\n  </select>\n</div>\n<div>\n  <label for=\"mensaje\" class=\"block mb-2 font-semibold\">Mensaje adicional (opcional)</label>\n  <textarea id=\"mensaje\" class=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\" rows=\"4\" placeholder=\"Ej. ¿Tienen mesas para grupos?\"></textarea>\n</div>\n<button type=\"submit\" class=\"w-full mt-6 bg-primary text-white py-4 rounded-2xl font-bold text-lg hover:bg-primary-dark transition duration-200\">\n  Reservar Mesa\n</button>\n</form>\n</div>\n</section>\n\n<!-- Mapa de ubicación -->\n<section class=\"py-24 bg-background text-center\">\n  <div class=\"max-w-7xl mx-auto px-4\">\n    <h2 class=\"text-3xl font-serif text-text mb-4\">Encuentra nuestro lugar</h2>\n    <p class=\"text-gray-600 mb-8\">Descubre dónde estamos en el mapa</p>\n    <div class=\"max-w-4xl mx-auto\">\n      <img src=\"https://foodandpleasure.com/wp-content/uploads/2025/03/cafeterias-de-especialidad-curva1-2-1200x858.jpg\" alt=\"Mapa de ubicación del restaurante\" class=\"rounded-3xl shadow-lg w-full\" />\n    </div>\n  </div>\n</section>\n\n<!-- Contacto -->\n<section class=\"py-24 bg-primary text-white\">\n  <div class=\"max-w-4xl mx-auto px-4 text-center\">\n    <h2 class=\"text-3xl font-serif mb-4\">Contáctanos</h2>\n    <p class=\"text-primary-100 mb-8\">¿Tienes preguntas? Estamos aquí para ayudarte</p>\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8 text-center\">\n      <div>\n        <h3 class=\"text-xl font-bold mb-2\">Teléfono</h3>\n        <p class=\"text-primary-100\">+54 11 1234-5678</p>\n      </div>\n      <div>\n        <h3 class=\"text-xl font-bold mb-2\">Correo</h3>\n        <p class=\"text-primary-100\">contacto@restaurante.com</p>\n      </div>\n      <div>\n        <h3 class=\"text-xl font-bold mb-2\">Dirección</h3>\n        <p class=\"text-primary-100\">Av. Siempre Viva 123, Ciudad Capital</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Footer -->\n<footer class=\"py-12 bg-gray-900 text-white\">\n  <div class=\"max-w-7xl mx-auto px-4 text-center\">\n    <p class=\"mb-4\">&copy; 2024 Restaurante El Sol. Todos los derechos reservados.</p>\n    <div class=\"flex justify-center space-x-6\">\n      <a href=\"#\" class=\"hover:text-primary transition\">Instagram</a>\n      <a href=\"#\" class=\"hover:text-primary transition\">Facebook</a>\n      <a href=\"#\" class=\"hover:text-primary transition\">Twitter</a>\n    </div>\n  </div>\n</footer>"}