# ELIPSE — plantilla de configuración
# Copia este archivo a ".env" (en la raíz del proyecto) y rellena lo que uses:
#   Linux/macOS:  cp .env.example .env
#   Windows CMD:  copy .env.example .env
# NO subas el ".env" real a git: contiene tus claves.

# --- Proveedor general: ollama | anthropic | openai | gemini ---
DEFAULT_PROVIDER=ollama

# Ollama (local). Si lo dejas comentado se usa el default de app/config.py
# OLLAMA_MODEL=hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M

# Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI o compatible (OpenRouter, Groq, LM Studio, vLLM...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

# Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Roles opcionales (vacío = heredan del general) ---
# CODE_PROVIDER=
# CODE_OLLAMA_MODEL=qwen2.5-coder:3b
# RESEARCH_PROVIDER=
# RESEARCH_OLLAMA_MODEL=phi3:mini

# --- Visión (NO hereda del general; VISION_PROVIDER vacío la desactiva) ---
# VISION_PROVIDER=ollama
# VISION_OLLAMA_MODEL=qwen3-vl:2b

# --- OCR: auto | rapidocr | tesseract | off ---
# OCR_ENGINE=auto